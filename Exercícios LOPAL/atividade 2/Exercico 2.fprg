    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="idadeNum" type="Integer" array="False" size=""/>
            <output expression="&quot;Insira sua idade:&quot;" newline="True"/>
            <input variable="idadeNum"/>
            <if expression="idadeNum &gt; 18">
                <then>
                    <output expression="&quot;Voc&#234; &#233; maior de idade.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Voc&#234; n&#227;o &#233; maior de idade.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
