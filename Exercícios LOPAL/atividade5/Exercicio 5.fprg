    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="numAleatorio" type="Real" array="False" size=""/>
            <output expression="&quot;Insira um n&#250;mero:&quot;" newline="True"/>
            <input variable="numAleatorio"/>
            <if expression="numAleatorio %5 = 0">
                <then>
                    <output expression="&quot; O n&#250;mero &#233; m&#250;ltiplo de 5.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero n&#227;o &#233; m&#250;ltiplo de 5.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
