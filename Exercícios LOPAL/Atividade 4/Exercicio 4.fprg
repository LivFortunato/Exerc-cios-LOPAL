<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Exercicio 4"/>
        <attribute name="authors" value="DES-I1HS"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2025-04-07 01:25:33 "/>
        <attribute name="created" value="REVTLUkxSFM7RVNONTEyTjZOVEI3NzQ7MjAyNS0wNC0wNzsiMTI6NTc6NTIgIjsyNjQz"/>
        <attribute name="edited" value="REVTLUkxSFM7RVNONTEyTjZOVEI3NzQ7MjAyNS0wNC0wNzsiMDE6MjU6MzMgIjsxOzI3NDM="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="valorCompra, valorDesconto, valorTotal" type="Real" array="False" size=""/>
            <output expression="&quot;Insira o valor da compra.&quot;" newline="True"/>
            <input variable="valorCompra"/>
            <if expression="valorCompra &gt;= 100">
                <then>
                    <assign variable="valorDesconto" expression="valorCompra *0.1"/>
                    <assign variable="valorTotal" expression="valorCompra - valorDesconto"/>
                    <output expression="&quot;Sua compra ganhou um desconto de 10% :)&quot;" newline="True"/>
                    <output expression="&quot;O valor do desconto &#233;:&quot; &amp;valorDesconto" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;Sua compra n&#227;o ganhou nenhum desconto :(&quot;" newline="True"/>
                </else>
            </if>
            <output expression="&quot;O valor da compra &#233;:&quot; &amp;valorCompra" newline="True"/>
        </body>
    </function>
</flowgorithm>
