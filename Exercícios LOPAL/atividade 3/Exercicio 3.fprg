    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="aleatorioNum" type="Real" array="False" size=""/>
            <output expression="&quot;Insira um n&#250;mero:&quot;" newline="True"/>
            <input variable="aleatorioNum"/>
            <if expression="aleatorioNum %2 = 0">
                <then>
                    <output expression="&quot;O n&#250;mero &#233; par.&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero n&#227;o &#233; par.&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
